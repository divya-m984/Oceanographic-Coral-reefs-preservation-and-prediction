# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.whl
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
!.env.example

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# MLflow
mlruns/
mlartifacts/
# Root-level mlflow.db is the empty SQLite default created by MLflow on first import.
# The canonical database lives at artifacts/mlruns.db and IS tracked.
/mlflow.db

# DVC
/tmp/
.dvc/cache/
.dvc/tmp/
.dvc/plots/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Data (tracked by DVC, not git)
data/raw/*.csv
data/processed/
data/reference/*.csv
data/production/*.csv

# Raw external scientific data (real, non-synthetic). Metadata under
# data/external/metadata/ IS tracked; the raw files are not, so this layer can
# later be placed under DVC without rewriting Git history. Ignoring raw/ is a
# storage decision, not a licensing one — per-product redistribution terms are
# recorded in each manifest's `redistribution_allowed` field.
data/external/raw/

# Local research material staged for audit — never committed.
# Holds third-party literature and externally licensed datasets (e.g. IUCN Red
# List spatial data, whose terms prohibit redistribution). See
# docs/audits/dataset_scientific_audit_2026-08-19.md sections 15 and 21.
data/audit_inbox/

# Model artifacts (tracked by DVC / MLflow)
models/*.pkl
models/*.joblib
models/*.json
models/*.cbm

# Deployment bundles (generated by scripts/export_champions.py — not tracked in git)
deploy/bundles/

# Reports (generated)
reports/*.html
reports/*.png
# Evidence manifest is generated on-demand by `make evidence` — not committed
reports/project_manifest.json

# Logs
*.log
logs/

# OS
Thumbs.db
.~lock.*#
