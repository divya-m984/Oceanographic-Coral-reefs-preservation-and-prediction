# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be committed.

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# MLflow tracking URI (local by default; override to use a remote server)
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlruns.db

# MLflow artifact store root
MLFLOW_ARTIFACT_ROOT=./artifacts/mlartifacts

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501

# Set to 1 to enable verbose DVC output
DVC_VERBOSE=0
