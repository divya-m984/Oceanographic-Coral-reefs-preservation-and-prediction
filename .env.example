# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be committed.

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# MLflow tracking URI (local by default; override to use a remote server)
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlruns.db

# MLflow artifact store root
MLFLOW_ARTIFACT_ROOT=./artifacts/mlartifacts

# FastAPI (src/config.py: cfg.api_host / cfg.api_port)
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501

# Base URL the dashboard uses for server-to-server API calls.
# Local default is http://127.0.0.1:8000; docker compose sets http://api:8000.
# A cloud deployment sets the full public HTTPS URL of the API here — no code
# change is required.
CORALSENSE_API_URL=http://127.0.0.1:8000

# Listening port for the API and dashboard container entrypoints.
# Leave unset locally: the images fall back to 8000 / 8501 respectively.
# Hosting providers such as Render inject PORT themselves; the containers bind
# 0.0.0.0 on whatever value is supplied.  Do NOT set this in .env for the
# Compose stack — it would apply to every service at once.
# PORT=8000

# Set to 1 to enable verbose DVC output
DVC_VERBOSE=0

# ---------------------------------------------------------------------------
# Docker / container configuration
# ---------------------------------------------------------------------------

# Model loading mode: "registry" (local dev) or "bundle" (containers)
# In bundle mode the API loads from deploy/bundles/ with no MLflow network call.
CORALSENSE_MODEL_MODE=registry

# Path to the deployment bundle inside the container (used when MODEL_MODE=bundle)
CORALSENSE_BUNDLE_PATH=deploy/bundles

# HOST ports published by docker compose (override to avoid conflicts).
# These select the host side of the mapping only; the container ports stay
# 5000 / 8000 / 8501.
MLFLOW_PORT=5000
# API_PORT already declared above
DASHBOARD_PORT=8501

# Drift monitoring scale factor (1.0 = standard synthetic shift)
DRIFT_SHIFT_SCALE=1.0
