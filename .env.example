# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be committed.

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# MLflow tracking URI (local by default; override to use a remote server)
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlruns.db

# MLflow artifact store root
MLFLOW_ARTIFACT_ROOT=./artifacts/mlartifacts

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501

# Set to 1 to enable verbose DVC output
DVC_VERBOSE=0

# ---------------------------------------------------------------------------
# Docker / container configuration
# ---------------------------------------------------------------------------

# Model loading mode: "registry" (local dev) or "bundle" (containers)
# In bundle mode the API loads from deploy/bundles/ with no MLflow network call.
CORALSENSE_MODEL_MODE=registry

# Path to the deployment bundle inside the container (used when MODEL_MODE=bundle)
CORALSENSE_BUNDLE_PATH=deploy/bundles

# Ports exposed by docker compose (override to avoid conflicts)
MLFLOW_PORT=5000
# API_PORT already declared above
DASHBOARD_PORT=8501

# Drift monitoring scale factor (1.0 = standard synthetic shift)
DRIFT_SHIFT_SCALE=1.0
