# Dockerfile.api — CoralSense FastAPI inference service.
#
# Multi-stage build:
#   build  — installs Python dependencies
#   runtime — copies source and bundle; runs as non-root
#
# Model-loading mode: BUNDLE
#   The deployment bundle (deploy/bundles/) is copied into the image at build
#   time.  No MLflow registry is contacted at runtime.  Checksums are verified
#   on every startup.
#
# Prerequisites (run on host before docker compose build):
#   python scripts/export_champions.py
#   python scripts/verify_deployment_bundle.py
#
# SYNTHETIC-DATA DISCLAIMER
# All predictions are generated by a model trained on synthetic data only.
# Do not use to guide real-world conservation decisions.

# syntax=docker/dockerfile:1
FROM python:3.12-slim AS build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Install dependencies in a separate layer so they are cached across rebuilds
# when only source code changes.
#
# Dependency notes:
#   - requirements-api.txt is the PUBLIC INFERENCE RUNTIME, not the full
#     development environment.  requirements.txt (MLflow, DVC, Evidently, shap,
#     Streamlit, pytest, ruff) is deliberately NOT installed here: bundle mode
#     contacts no registry, runs no DVC command and computes no drift, so none
#     of it is reachable from a prediction request.  See the header of
#     requirements-api.txt for the per-package justification.
#   - Every package needed to unpickle and execute BOTH champions is present:
#     joblib, numpy, scikit-learn (health = LogisticRegression, plus both
#     ColumnTransformers) and xgboost (restoration champion).
COPY requirements-api.txt .
RUN pip install --upgrade pip \
    && pip install -r requirements-api.txt


# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Bundle mode: load champion models from deploy/bundles/, not the registry.
    CORALSENSE_MODEL_MODE=bundle \
    CORALSENSE_BUNDLE_PATH=/app/deploy/bundles \
    # Listening port.  Always bound on 0.0.0.0.  Cloud hosts such as Render
    # inject their own PORT, which overrides this default at runtime; locally
    # and under Docker Compose the value below keeps port 8000.
    PORT=8000

WORKDIR /app

# Copy installed packages from the build stage
COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /usr/local/bin /usr/local/bin

# Create non-root user
RUN groupadd -r coralsense \
    && useradd -r -g coralsense -d /app -s /sbin/nologin coralsense

# Copy application source and docker helper scripts
COPY src/ ./src/
COPY params.yaml pyproject.toml ./
COPY docker/ ./docker/

# Install the local package (editable-style, no deps re-download)
RUN pip install --no-deps -e .

# Copy the deployment bundle (generated by scripts/export_champions.py).
# Fails the build if the bundle directory is missing.
COPY deploy/bundles/ ./deploy/bundles/

# Set correct ownership
RUN chown -R coralsense:coralsense /app

USER coralsense

EXPOSE 8000

# Health check via Python stdlib (no curl dependency).
#
# Targets /ready, not /health: the container is only "healthy" once BOTH
# champion pipelines have loaded from the checksum-verified bundle.  /ready
# answers 503 while degraded, which urlopen raises on, so a bundle-integrity
# failure keeps the container out of service instead of silently serving 503s.
# /health remains available as the process-liveness endpoint.
#
# Shell form so ${PORT} is expanded by /bin/sh at runtime.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://localhost:'+'${PORT:-8000}'+'/ready', timeout=8).status == 200 else 1)"

# Shell form so a hosting provider's injected ${PORT} is honoured; falls back
# to 8000 locally.  exec keeps uvicorn as PID 1 for correct signal handling.
CMD ["/bin/sh", "-c", \
     "exec uvicorn src.api.main:app --host 0.0.0.0 --port \"${PORT:-8000}\" --workers 1 --log-level info"]
