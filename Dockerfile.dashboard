# Dockerfile.dashboard — CoralSense Streamlit dashboard.
#
# The dashboard:
#   - makes ALL predictions through the FastAPI service (no direct model loading)
#   - reads synthetic observation data for visualisation (baked in, read-only)
#   - uses CORALSENSE_API_URL to reach the API (http://api:8000 under Compose,
#     a full HTTPS URL when deployed behind a hosting provider)
#
# Standalone runtime assets
# -------------------------
# The image bakes in the read-only synthetic demonstration assets so it runs
# without host bind mounts.  A release workflow restores them with `dvc pull`
# BEFORE calling `docker build`; the build itself never contacts DVC/DagsHub,
# never trains, never generates data, and carries no credentials.  Compose
# still bind-mounts the same paths locally, which simply overlays identical
# host copies.
#
#   data/raw/observations.csv       required — every visualisation page
#   models/evaluation_*.json        required — Model Performance / Overview
#   reports/drift_summary.json      optional — Drift + Governance pages degrade
#                                              gracefully when absent
#
# The dashboard contacts NO MLflow service and runs NO DVC command at runtime.
#
# SYNTHETIC-DATA DISCLAIMER
# All visualisations and predictions are based on synthetic data only.

# syntax=docker/dockerfile:1
FROM python:3.12-slim AS build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

# Dependency notes:
#   - The dashboard does not import evidently; page 8 reads reports/drift_summary.json.
#     Dropping it keeps the image smaller; the plotly pin is unchanged either way.
#   - plotly stays on the requirements.txt range (>=5.24,<6).  px.scatter_map, used
#     by the Reef Map page, was introduced in plotly 5.24.0 — not plotly 6 — so the
#     evidently-compatible 5.x range fully supports this dashboard.
COPY requirements.txt .
RUN pip install --upgrade pip \
    && grep -v "^evidently" requirements.txt > /tmp/reqs_dash.txt \
    && pip install -r /tmp/reqs_dash.txt


# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # API connection — overridden by docker-compose.yml to http://api:8000
    CORALSENSE_API_URL=http://api:8000 \
    # Disable Streamlit telemetry and browser auto-open
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_HEADLESS=true \
    # Listening port.  Always bound on 0.0.0.0.  Cloud hosts such as Render
    # inject their own PORT, which overrides this default at runtime; locally
    # and under Docker Compose the value below keeps port 8501.  The server
    # port/address are passed on the CMD line, so STREAMLIT_SERVER_PORT and
    # STREAMLIT_SERVER_ADDRESS are deliberately not duplicated here.
    PORT=8501

WORKDIR /app

COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /usr/local/bin /usr/local/bin

# Create non-root user
RUN groupadd -r coralsense \
    && useradd -r -g coralsense -d /app -s /sbin/nologin coralsense

# Copy source and config
COPY src/ ./src/
COPY params.yaml pyproject.toml ./
COPY .streamlit/ ./.streamlit/

# Install local package
RUN pip install --no-deps -e .

# ── Read-only synthetic demonstration assets ─────────────────────────────────
# Restored by `dvc pull` in CI before the build.  A missing required asset
# fails the build rather than producing a silently broken dashboard image.
COPY data/raw/observations.csv ./data/raw/observations.csv
COPY models/evaluation_health.json models/evaluation_restoration.json ./models/
# Optional: pages 8 and 9 render a "not found" notice when this is absent.
COPY reports/drift_summary.json ./reports/

RUN chown -R coralsense:coralsense /app

USER coralsense

EXPOSE 8501

# Shell form so ${PORT} is expanded by /bin/sh at runtime.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://localhost:'+'${PORT:-8501}'+'/_stcore/health', timeout=8).status == 200 else 1)"

# Shell form so a hosting provider's injected ${PORT} is honoured; falls back
# to 8501 locally.  exec keeps streamlit as PID 1 for correct signal handling.
CMD ["/bin/sh", "-c", \
     "exec streamlit run src/dashboard/app.py --server.port \"${PORT:-8501}\" --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
