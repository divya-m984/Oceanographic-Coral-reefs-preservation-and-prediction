# Dockerfile.dashboard — CoralSense Streamlit dashboard.
#
# The dashboard:
#   - makes ALL predictions through the FastAPI service (no direct model loading)
#   - reads synthetic observation data for visualisation (mounted read-only)
#   - uses CORALSENSE_API_URL=http://api:8000 to reach the API container
#
# SYNTHETIC-DATA DISCLAIMER
# All visualisations and predictions are based on synthetic data only.

# syntax=docker/dockerfile:1
FROM python:3.12-slim AS build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

# Dependency notes:
#   - The dashboard does not import evidently; page 8 reads reports/drift_summary.json.
#   - Removing evidently avoids its plotly<6 constraint, allowing plotly>=6.0 which
#     the Reef Map page requires (px.scatter_map, introduced in plotly 6).
COPY requirements.txt .
RUN pip install --upgrade pip \
    && grep -v "^evidently" requirements.txt > /tmp/reqs_dash.txt \
    && pip install -r /tmp/reqs_dash.txt


# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # API connection — overridden by docker-compose.yml to http://api:8000
    CORALSENSE_API_URL=http://api:8000 \
    # Disable Streamlit telemetry and browser auto-open
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0

WORKDIR /app

COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /usr/local/bin /usr/local/bin

# Create non-root user
RUN groupadd -r coralsense \
    && useradd -r -g coralsense -d /app -s /sbin/nologin coralsense

# Copy source and config
COPY src/ ./src/
COPY params.yaml pyproject.toml ./
COPY .streamlit/ ./.streamlit/

# Install local package
RUN pip install --no-deps -e .

# Create data directories — actual data files are bind-mounted at runtime
RUN mkdir -p /app/data/raw /app/data/reference /app/reports \
    && chown -R coralsense:coralsense /app

USER coralsense

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c \
        "import urllib.request, sys; \
         r = urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=8); \
         sys.exit(0 if r.status == 200 else 1)"

CMD ["streamlit", "run", "src/dashboard/app.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0", \
     "--server.headless", "true", \
     "--browser.gatherUsageStats", "false"]
